# ==============================================================================
# SmartInvest AI Engine Configuration
# ==============================================================================

# System Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Settings
# (Use 'localhost' for local virtualenv, or 'postgres' when running inside Docker Compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smartinvest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smartinvest

# Redis Settings
# (Use 'localhost' for local virtualenv, or 'redis' when running inside Docker Compose)
REDIS_URL=redis://localhost:6379/0

# AI Configuration (Supports OpenAI, Gemini, Groq, OpenRouter)
OPENAI_API_KEY=
OPENAI_API_BASE=
LLM_MODEL_NAME=gpt-4o-mini

# Telegram Bot Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_SYMBOLS=NIFTY50,DOW

# API Security
# (Leave empty to bypass authentication in local development. Enforced if populated)
API_KEY=
